SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Redis URL used by application.properties (docker compose sets redis://redis:6379 itself)
SPRING_DATA_REDIS_URL=redis://localhost:6379

# ---- React frontend integration ----
# Origin(s) of the React app allowed by CORS / WebSocket (comma separated, no trailing slash)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Keep lax/false when frontend and API share a site (localhost, or app.example.com + api.example.com).
# Use none/true when they are on different sites (e.g. *.vercel.app + *.onrender.com; HTTPS required).
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false

# ---- Roles ----
# E-mails of already-registered users to promote to ADMIN at startup (comma separated)
APP_ADMIN_EMAILS=

# ---- Travel plans ----
# Time zone used to decide when a trip's start date is reached (auto-close). Optional, default Asia/Kolkata.
APP_TIMEZONE=Asia/Kolkata
